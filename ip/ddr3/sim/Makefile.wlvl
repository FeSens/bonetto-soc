# cocotb Makefile for ddr3_phy_wlvl FSM.
# Driven by 'make -C ip/ddr3 wlvl' (added below).

unexport PYTHONPATH
unexport PYTHONNOUSERSITE
unexport PYTHONHOME

OSS_CAD_SUITE_BIN ?= /Users/bonetto/bonetto/riscv-autoarch/.toolchain/oss-cad-suite/bin
export PATH := $(OSS_CAD_SUITE_BIN):$(PATH)

SIM           ?= icarus
TOPLEVEL_LANG ?= verilog
TOPLEVEL      ?= ddr3_phy_wlvl
MODULE        ?= test_ddr3_phy_wlvl

COCOTB_RESULTS_FILE ?= results_wlvl.xml
SIM_BUILD           ?= sim_build_wlvl

VERILOG_INCLUDE_DIRS = ../rtl
VERILOG_SOURCES = ../rtl/ddr3_phy_wlvl.v

COMPILE_ARGS += -g2012 -DBONETTO_SOC_SIM

COCOTB_PYTHON ?= $(shell for py in $(OSS_CAD_SUITE_BIN)/tabbypy3 /opt/homebrew/Caskroom/miniconda/base/bin/python3.13 /opt/homebrew/bin/python3 python3; do \
	if env -u PYTHONPATH -u PYTHONNOUSERSITE $$py -c 'import cocotb, cocotb_tools' >/dev/null 2>&1; then \
		printf '%s\n' "$$py"; \
		break; \
	fi; \
done)

ifeq ($(strip $(COCOTB_PYTHON)),)
$(error No Python with cocotb/cocotb_tools found. Install cocotb or set COCOTB_PYTHON=/path/to/python)
endif

COCOTB_MAKEFILES := $(shell env -u PYTHONPATH -u PYTHONNOUSERSITE $(COCOTB_PYTHON) -m cocotb_tools.config --makefiles)

include $(COCOTB_MAKEFILES)/Makefile.sim
